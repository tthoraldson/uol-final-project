@misc{bittner2022lightweight,
  title = {A {{Lightweight Instrument-Agnostic Model}} for {{Polyphonic Note Transcription}} and {{Multipitch Estimation}}},
  author = {Bittner, Rachel M. and Bosch, Juan Jos{\'e} and Rubinstein, David and {Meseguer-Brocal}, Gabriel and Ewert, Sebastian},
  year = 2022,
  month = may,
  number = {arXiv:2203.09893},
  eprint = {2203.09893},
  primaryclass = {cs.SD},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2203.09893},
  urldate = {2026-06-28},
  abstract = {Automatic Music Transcription (AMT) has been recognized as a key enabling technology with a wide range of applications. Given the task's complexity, best results have typically been reported for systems focusing on specific settings, e.g. instrument-specific systems tend to yield improved results over instrument-agnostic methods. Similarly, higher accuracy can be obtained when only estimating frame-wise \$f\_0\$ values and neglecting the harder note event detection. Despite their high accuracy, such specialized systems often cannot be deployed in the real-world. Storage and network constraints prohibit the use of multiple specialized models, while memory and run-time constraints limit their complexity. In this paper, we propose a lightweight neural network for musical instrument transcription, which supports polyphonic outputs and generalizes to a wide variety of instruments (including vocals). Our model is trained to jointly predict frame-wise onsets, multipitch and note activations, and we experimentally show that this multi-output structure improves the resulting frame-level note accuracy. Despite its simplicity, benchmark results show our system's note estimation to be substantially better than a comparable baseline, and its frame-level accuracy to be only marginally below those of specialized state-of-the-art AMT systems. With this work we hope to encourage the community to further investigate low-resource, instrument-agnostic AMT systems.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Computer Science - Sound,Electrical Engineering and Systems Science - Audio and Speech Processing},
  file = {/Users/theresa/Zotero/storage/ZHVABSAH/Bittner et al. - 2022 - A Lightweight Instrument-Agnostic Model for Polyphonic Note Transcription and Multipitch Estimation.pdf;/Users/theresa/Zotero/storage/34P4ZYW5/2203.html}
}

@article{carnovalini2025personalized,
  title = {Personalized {{Music Education}}: {{A Systematic Review}} of {{AI Generation Methods}}},
  shorttitle = {Personalized {{Music Education}}},
  author = {Carnovalini, Filippo and Esp{\'i}rito Santo, Lu{\'i}s and Wiggins, Geraint A.},
  year = 2025,
  journal = {IEEE Access},
  volume = {13},
  pages = {207433--207447},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2025.3639898},
  urldate = {2026-06-28},
  abstract = {Despite recent notable advances of AI-Education research, formal music education is still largely performed as it was at the beginning of the last century. Instrument technical practice especially is still largely performed in a classical setting with little use of modern technologies, possibly due to being a skill-based curriculum. While other researchers have argued for the potential benefits of using Artificial Intelligence for the personalization of music education, it still seems to be rare both in schools and in research. In this paper, we present a systematic literature review exploring the use of computational generation of exercises for personalized music learning, with a special interest in piano. To do so, we retrieve research papers that use AI to improve personalization in music education exploring both what computational methods can provide personalization in music teaching, and how frequently AI is actually used for generation in this context. We screened 360 papers retrieved from online repositories, selecting 40 relevant papers that would satisfy some minimal quality requirements. Analyzing the papers, we found that while there is interest from the scientific community in improving music education through AI and computational means more generally, AI is under-utilized for generation despite its potential for personalization. We found no examples of generation of piano technical exercises, and, more generally, that instrumental technique is indeed the aspect that has seen lesser use of AI enhancement, often limited to adding visualizations to normal instrumental practice.},
  keywords = {AI-education,Artificial intelligence,Computer science,Education,Europe,generative AI,Generative AI,Instruments,Music,music education,music generation,personalization,Surveys,systematic literature review,Systematic literature review,Visualization},
  file = {/Users/theresa/Zotero/storage/V89ZXZSL/Carnovalini et al. - 2025 - Personalized Music Education A Systematic Review of AI Generation Methods.pdf}
}

@misc{copet2024simple,
